DISCORD_BOT_TOKEN=replace-with-discord-bot-token
CBGRAPHS_API_BASE_URL=https://www.cbgraphs.info
CBGRAPHS_API_KEY=cbg_live_replace-with-read-only-key
# Set this for instant slash-command sync to one test server. Leave 0 for global sync.
DISCORD_GUILD_ID=0
CBGRAPHS_BOT_DB=cbgraphs-bot.sqlite3
CBGRAPHS_SYNC_INTERVAL_SECONDS=900
CBGRAPHS_SYNC_NICKNAMES=true
CBGRAPHS_SYNC_ROLES=true
LOG_LEVEL=INFO
